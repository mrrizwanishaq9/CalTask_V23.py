class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"

    RED = "\033[91m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    MAGENTA = "\033[95m"
    CYAN = "\033[96m"
    WHITE = "\033[97m"


def color(text, colour):
    return f"{colour}{text}{Colors.RESET}"


def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


def pause():
    input("\nPress ENTER to continue...")


def header(title):
    clear_screen()

    print("=" * 72)
    print(f"{Colors.CYAN}{Colors.BOLD}{APP_NAME:^72}{Colors.RESET}")
    print(f"{Colors.WHITE}{title:^72}{Colors.RESET}")
    print("=" * 72)


def safe_input(prompt):
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        return ""


