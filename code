    def pomodoro(self):
        header("Pomodoro Timer")

        print("Default: 25 minutes work + 5 minutes break")
        print()

        minutes_text = safe_input(
            "Work minutes [25]: "
        )

        try:
            minutes = int(minutes_text) if minutes_text else 25

            if minutes <= 0:
                raise ValueError

        except ValueError:
            print("Invalid minutes.")
            pause()
            return

        seconds = minutes * 60

        print()
        print(color("Pomodoro started.", Colors.GREEN))

        try:
            while seconds > 0:
                mins = seconds // 60
                secs = seconds % 60

                print(
                    f"\rTime remaining: "
                    f"{mins:02d}:{secs:02d}",
                    end="",
                    flush=True
                )

                time.sleep(1)
                seconds -= 1

        except KeyboardInterrupt:
            print("\nTimer stopped.")
            return

        print("\n")
        print(color("Pomodoro complete!", Colors.GREEN))

        pause()

