    # --------------------------------------------------------

    def run(self):

        if not self.check_pin():
            return

        while True:

            self.dashboard()

            choice = safe_input(
                "\nCommand: "
            ).lower()

            if choice == "1":
                self.task_menu()

            elif choice == "2":
                self.calendar_view()

            elif choice == "3":
                self.appointment_menu()

            elif choice == "4":
                self.search()

            elif choice == "5":
                self.reports()

            elif choice == "6":
                self.pomodoro()

            elif choice == "7":
                self.notes_menu()

            elif choice == "8":
                self.backup_menu()

            elif choice == "9":
                self.settings()

            elif choice == "x":
                self.export_menu()

            elif choice == "c":
                self.clear_completed()

            elif choice == "h":
                self.help_screen()

            elif choice == "0":
                clear_screen()
                print(
                    color(
                        "CalTask V23 closed. Goodbye!",
                        Colors.GREEN
                    )
                )
                break

            else:
                print(
                    color(
                        "Unknown command.",
                        Colors.YELLOW
                    )
                )
                time.sleep(1)


