class Database:

    def __init__(self):
        BASE_DIR.mkdir(parents=True, exist_ok=True)
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        EXPORT_DIR.mkdir(parents=True, exist_ok=True)

        self.data = self.load()

    def default_data(self):
        return {
            "tasks": [],
            "appointments": [],
            "notes": [],
            "settings": {
                "pin_enabled": False,
                "pin_hash": "",
                "theme": "default"
            }
        }

    def load(self):
        if not DATA_FILE.exists():
            data = self.default_data()
            self.save(data)
            return data

        try:
            with open(DATA_FILE, "r", encoding="utf-8") as file:
                data = json.load(file)

            if not isinstance(data, dict):
                return self.default_data()

            data.setdefault("tasks", [])
            data.setdefault("appointments", [])
            data.setdefault("notes", [])
            data.setdefault("settings", {})

            data["settings"].setdefault("pin_enabled", False)
            data["settings"].setdefault("pin_hash", "")
            data["settings"].setdefault("theme", "default")

            return data

        except (OSError, json.JSONDecodeError):
            print(color("Database could not be loaded. Starting fresh.", Colors.YELLOW))
            return self.default_data()

    def save(self, data=None):
        if data is not None:
            self.data = data

        temporary_file = DATA_FILE.with_suffix(".tmp")

        try:
            with open(temporary_file, "w", encoding="utf-8") as file:
                json.dump(self.data, file, indent=4, ensure_ascii=False)

            shutil.move(str(temporary_file), str(DATA_FILE))

        except OSError as error:
            print(color(f"Save error: {error}", Colors.RED))

    def backup(self):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_file = BACKUP_DIR / f"caltask_backup_{timestamp}.json"

        try:
            shutil.copy2(DATA_FILE, backup_file)
            return backup_file
        except OSError:
            return None

    def restore(self, backup_file):
        try:
            shutil.copy2(backup_file, DATA_FILE)

            with open(DATA_FILE, "r", encoding="utf-8") as file:
                self.data = json.load(file)

            return True

        except (OSError, json.JSONDecodeError):
            return False


