    # --------------------------------------------------------
    # EXPORT
    # --------------------------------------------------------

    def export_menu(self):
        header("Export Data")

        print("1. Export tasks to CSV")
        print("2. Export all data to JSON")
        print("3. Export tasks to TXT")
        print("0. Back")

        choice = safe_input("\nSelect: ")

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

        if choice == "1":
            file_path = EXPORT_DIR / f"tasks_{timestamp}.csv"

            try:
                with open(
