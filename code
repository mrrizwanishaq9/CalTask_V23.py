    # --------------------------------------------------------

    def new_id(self):
        all_items = (
            self.db.data["tasks"]
            + self.db.data["appointments"]
            + self.db.data["notes"]
        )

        ids = []

        for item in all_items:
            try:
                ids.append(int(item.get("id", 0)))
            except (TypeError, ValueError):
                pass

        if not ids:
            return 1

        return max(ids) + 1

