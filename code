    def filter_tasks(self):
        header("Filter Tasks")

        print("1. Completed")
        print("2. Pending")
        print("3. High priority")
        print("4. Overdue")
        print("5. By category")

        choice = safe_input("\nSelect: ")

        tasks = self.db.data["tasks"]

        if choice == "1":
            result = [
                task for task in tasks
                if task.get("completed")
            ]

        elif choice == "2":
            result = [
                task for task in tasks
                if not task.get("completed")
            ]

        elif choice == "3":
            result = [
                task for task in tasks
                if task.get("priority") in ("High", "Critical")
            ]

        elif choice == "4":
            today_text = date.today().isoformat()

            result = [
                task for task in tasks
                if (
                    not task.get("completed")
                    and task.get("due_date")
                    and task.get("due_date") < today_text
                )
            ]

        elif choice == "5":
            category = safe_input("Category: ").lower()

            result = [
                task for task in tasks
                if task.get("category", "").lower() == category
            ]

        else:
            result = []

        print()

        if not result:
            print("No matching tasks.")
        else:
            for task in result:
                print(
                    f"#{task.get('id')} | "
                    f"{task.get('title')} | "
                    f"{task.get('priority')} | "
                    f"{task.get('due_date') or 'None'}"
                )

        pause()

