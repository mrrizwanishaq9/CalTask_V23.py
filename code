    def add_task(self):
        header("Add Task")

        title = safe_input("Task title: ")

        if not title:
            print(color("Title cannot be empty.", Colors.RED))
            pause()
            return

        description = safe_input("Description: ")

        due_date = safe_input(
            "Due date (YYYY-MM-DD, blank = none): "
        )

        if due_date:
            try:
                datetime.strptime(due_date, "%Y-%m-%d")
            except ValueError:
                print(color("Invalid date format.", Colors.RED))
                pause()
                return

        print("\nPriority:")
        print("1. Low")
        print("2. Medium")
        print("3. High")
        print("4. Critical")

        priority_choice = safe_input("Select priority: ")

        if priority_choice not in PRIORITIES:
            priority_choice = "2"

        print("\nCategory:")
        for index, category in enumerate(CATEGORIES, 1):
            print(f"{index}. {category}")

        category_choice = safe_input("Select category: ")

        try:
            category_index = int(category_choice)
            if 1 <= category_index <= len(CATEGORIES):
                category = CATEGORIES[category_index - 1]
            else:
                category = "Other"
        except ValueError:
            category = "Other"

        tags = safe_input("Tags (comma separated): ")

        task = {
            "id": self.new_id(),
            "title": title,
            "description": description,
            "due_date": due_date,
            "priority": PRIORITIES[priority_choice],
            "category": category,
            "tags": [tag.strip() for tag in tags.split(",") if tag.strip()],
            "completed": False,
            "created_at": datetime.now().isoformat(timespec="seconds"),
            "completed_at": "",
            "recurring": ""
        }

        self.db.data["tasks"].append(task)
        self.db.save()

        print(color("\nTask added successfully.", Colors.GREEN))
        pause()

    def list_tasks(self):
        header("All Tasks")

        tasks = self.db.data["tasks"]

        if not tasks:
            print("No tasks found.")
            pause()
            return

        ordered = sorted(
            tasks,
            key=lambda item: (
                item.get("completed", False),
                item.get("due_date", "9999-12-31")
            )
        )

        for task in ordered:
            status = "DONE" if task.get("completed") else "TODO"

            priority = task.get("priority", "Medium")

            if priority == "Critical":
                priority_text = color(priority, Colors.RED)
            elif priority == "High":
                priority_text = color(priority, Colors.YELLOW)
            elif priority == "Low":
                priority_text = color(priority, Colors.BLUE)
            else:
                priority_text = priority

            print("-" * 72)
            print(
                f"[{status}] "
                f"#{task.get('id')} "
                f"{task.get('title')}"
            )

            print(f"Priority : {priority_text}")
            print(f"Category : {task.get('category', 'Other')}")
            print(f"Due      : {task.get('due_date') or 'None'}")

            tags = task.get("tags", [])

            if tags:
                print(f"Tags     : {', '.join(tags)}")

            description = task.get("description", "")

            if description:
                print(f"Details  : {description}")

        pause()

    def find_task(self, task_id):
        for task in self.db.data["tasks"]:
            if str(task.get("id")) == str(task_id):
                return task

        return None

    def complete_task(self):
