    # --------------------------------------------------------
    # CLEAN COMPLETED
    # --------------------------------------------------------

    def clear_completed(self):
        header("Clear Completed Tasks")

        completed = [
            task for task in self.db.data["tasks"]
            if task.get("completed")
        ]

        if not completed:
            print("No completed tasks.")
            pause()
            return

        print(
            f"Completed tasks found: {len(completed)}"
        )

        confirm = safe_input(
            "Delete all completed tasks? (y/n): "
        ).lower()

        if confirm == "y":

            self.db.data["tasks"] = [
                task for task in self.db.data["tasks"]
                if not task.get("completed")
            ]

            self.db.save()

            print(
                color(
                    "Completed tasks removed.",
                    Colors.GREEN
                )
            )

        else:
            print("Cancelled.")

        pause()

    # --------------------------------------------------------
    # SETTINGS / PIN
    # --------------------------------------------------------

    def settings(self):
        header("Settings")

        enabled = self.db.data["settings"].get(
            "pin_enabled",
            False
        )

        print(
            f"PIN lock: "
            f"{'ON' if enabled else 'OFF'}"
        )

        print()
        print("1. Enable PIN")
        print("2. Disable PIN")
        print("0. Back")

        choice = safe_input("\nSelect: ")

        if choice == "1":

            pin = getpass.getpass(
                "Create PIN: "
            )

            if not pin:
                print("PIN cannot be empty.")
                pause()
                return

            confirm = getpass.getpass(
                "Confirm PIN: "
            )

            if pin != confirm:
                print(
                    color(
                        "PINs do not match.",
                        Colors.RED
                    )
                )
                pause()
                return

            pin_hash = hashlib.sha256(
                pin.encode("utf-8")
            ).hexdigest()

            self.db.data["settings"]["pin_enabled"] = True
            self.db.data["settings"]["pin_hash"] = pin_hash

            self.db.save()

            print(
                color(
                    "PIN lock enabled.",
                    Colors.GREEN
                )
            )

            pause()

        elif choice == "2":

            self.db.data["settings"]["pin_enabled"] = False
            self.db.data["settings"]["pin_hash"] = ""

            self.db.save()

            print(
                color(
                    "PIN lock disabled.",
                    Colors.GREEN
                )
            )

            pause()

    def check_pin(self):

        settings = self.db.data.get("settings", {})

        if not settings.get("pin_enabled"):
            return True

        print(
            color(
                f"\n{APP_NAME} is PIN protected.",
                Colors.YELLOW
            )
        )

        pin = getpass.getpass("Enter PIN: ")

        entered_hash = hashlib.sha256(
            pin.encode("utf-8")
        ).hexdigest()

        stored_hash = settings.get(
            "pin_hash",
            ""
        )

        if entered_hash == stored_hash:
            return True

        print(
            color(
                "Incorrect PIN.",
                Colors.RED
            )
        )

        return False

