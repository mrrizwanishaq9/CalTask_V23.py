                    writer.writerow([
                        "ID",
                        "Title",
                        "Description",
                        "Due Date",
                        "Priority",
                        "Category",
                        "Completed"
                    ])

                    for task in self.db.data["tasks"]:
                        writer.writerow([
                            task.get("id"),
                            task.get("title"),
                            task.get("description"),
                            task.get("due_date"),
                            task.get("priority"),
                            task.get("category"),
                            task.get("completed")
                        ])

                print(
                    color(
                        f"CSV exported:\n{file_path}",
                        Colors.GREEN
                    )
                )

            except OSError as error:
                print(color(f"Export error: {error}", Colors.RED))

            pause()

        elif choice == "2":
            file_path = EXPORT_DIR / f"caltask_{timestamp}.json"

            try:
                with open(
                    file_path,
                    "w",
                    encoding="utf-8"
                ) as file:

                    json.dump(
                        self.db.data,
                        file,
                        indent=4,
                        ensure_ascii=False
                    )

                print(
                    color(
                        f"JSON exported:\n{file_path}",
                        Colors.GREEN
                    )
                )

            except OSError as error:
                print(color(f"Export error: {error}", Colors.RED))

            pause()

        elif choice == "3":
            file_path = EXPORT_DIR / f"tasks_{timestamp}.txt"

            try:
                with open(
                    file_path,
                    "w",
                    encoding="utf-8"
                ) as file:

                    for task in self.db.data["tasks"]:

                        file.write(
                            f"ID: {task.get('id')}\n"
                        )

                        file.write(
                            f"Title: {task.get('title')}\n"
                        )

                        file.write(
                            f"Due: {task.get('due_date')}\n"
                        )

                        file.write(
                            f"Priority: {task.get('priority')}\n"
