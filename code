    # BACKUP / RESTORE
    # --------------------------------------------------------

    def backup_menu(self):
        header("Backup / Restore")

        print("1. Create backup")
        print("2. Restore latest backup")
        print("3. List backups")
        print("0. Back")

        choice = safe_input("\nSelect: ")

        if choice == "1":
            backup = self.db.backup()

            if backup:
                print(
                    color(
                        f"Backup created:\n{backup}",
                        Colors.GREEN
                    )
                )
            else:
                print(color("Backup failed.", Colors.RED))

            pause()

        elif choice == "2":
            backups = sorted(
                BACKUP_DIR.glob("*.json"),
                reverse=True
            )

            if not backups:
                print("No backups found.")
                pause()
                return

            latest = backups[0]

            confirm = safe_input(
                f"Restore {latest.name}? (y/n): "
            ).lower()

            if confirm == "y":

                if self.db.restore(latest):
